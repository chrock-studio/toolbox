{
  "name": "@chrock-studio/overload",
  "version": "0.3.0",
  "description": "Type-safe runtime function overloading for TypeScript, with optional ahead-of-time compiled dispatch.",
  "keywords": [
    "aot",
    "dispatch",
    "function-overloading",
    "overload",
    "overloading",
    "performance",
    "standard-schema",
    "type-guard",
    "typescript"
  ],
  "homepage": "https://github.com/chrock-studio/toolbox/tree/main/packages/overload#readme",
  "bugs": {
    "url": "https://github.com/chrock-studio/toolbox/issues"
  },
  "license": "MIT",
  "author": "ChrockStudio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrock-studio/toolbox.git",
    "directory": "packages/overload"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "type-fest": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
